{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=noodlemaps.db"
  },
  "Auth": {
    // 機密はここに書かず、実行時に環境変数 / .env / user-secrets / appsettings.Development.json から供給する。
    //   - Auth__EmailHashKey : メールを HMAC-SHA256 ハッシュ化する秘密鍵（必須。未設定なら認証系は 500 で fail-closed）
    //   - Auth__InviteCode   : オーナー不在時のブートストラップ用固定合言葉（空なら固定合言葉での登録は無効）
    //   - Auth__OwnerEmail   : 「初代食べる王」称号を付与するオーナーのメールアドレス
    // 詳細は backend/.env.example を参照。値をこのファイルに直接コミットしないこと。
    "InviteCode": "",
    "EmailHashKey": ""
  },
  "Members": []
}
