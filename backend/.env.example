# backend/.env としてコピーして使う（.env はgit追跡外・Dockerイメージにも含めない）。
# "__" 区切りは ASP.NET Core の環境変数プロバイダにより "Places:GoogleApiKey" のように読み込まれる。
#
# ローカルで `dotnet run`（Development）する場合は appsettings.Development.json でも設定できるが、
# Docker（イメージにシークレットを焼き込まない）では下記を env 経由で必ず供給すること。

# Google Places API (New) のサーバー用APIキー
Places__GoogleApiKey=

# メールアドレスを HMAC-SHA256 でハッシュ化する際のサーバー秘密鍵（長いランダム文字列）。
# 変更すると既存ユーザーのログイン照合ができなくなるため運用開始後は固定すること。
# 未設定だと login/register/forgotPassword/resetPassword は 500 で fail-closed する（意図的な安全側動作）。
# 生成例: openssl rand -hex 32
Auth__EmailHashKey=

# 「初代食べる王」称号を付与する対象オーナーのメールアドレス
Auth__OwnerEmail=

# オーナー不在時にだけ有効な、ブートストラップ用の固定合言葉（最初の1人が登録するためのもの）。
# オーナーが誕生すると自動で無効化される。空にすると固定合言葉での登録は最初から無効
# （ワンタイム招待コードのみで登録可能）。appsettings.json には直接書かないこと。
Auth__InviteCode=

# 初期メンバーの表示名（セミコロン区切り）。起動時に DisplayName だけのユーザーを作成する。
# appsettings.json に実名を書くと git に残るため、ここから供給すること。
Members__0=
Members__1=
Members__2=
